{
    "idf.currentSetup": "C:\\esp\\v6.1\\esp-idf",
    "idf.openOcdConfigs": [
        "board/esp32c3-builtin.cfg"
    ],
    "idf.customExtraVars": {
        "IDF_TARGET": "esp32c3"
    },
    "clangd.path": "C:\\Espressif\\tools\\esp-clang\\esp-20.1.1_20250829\\esp-clang\\bin\\clangd.exe",
    "clangd.arguments": [
      "--background-index",
      "--query-driver=**",
      "--compile-commands-dir=${config:idf.buildPath}/build"
    ],
    "idf.flashType": "JTAG",
    "idf.port": "COM4",
    "C_Cpp.default.compilerPath": "${config:idf.buildPath}/compile_commands.json"
}