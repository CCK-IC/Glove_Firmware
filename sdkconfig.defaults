CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=4
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=128
CONFIG_BT_NIMBLE_NVS_PERSIST=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=3000
CONFIG_ESP_TASK_WDT=n
CONFIG_ICM_20948_USE_DMP=n
CONFIG_I2C_MASTER_SCL=7
CONFIG_I2C_MASTER_SDA=6


CONFIG_TARGET_BOARD_XIAO_ESP32_C3=y
CONFIG_IMU_RATE_HZ=120
CONFIG_IMU_SLOW_RATE_HZ=25
CONFIG_BATTERY_STATUS_PERIOD_MS=1000
CONFIG_POWER_LATCH_TEST_MODE=n